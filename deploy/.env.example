# Copy to deploy/.env (git-ignored) and fill in. Never commit a filled copy.
# For systemd, install the same contents at /etc/claude-runner/env, mode 0600.

# ---------------------------------------------------------------- required

# "personal" — you are the only caller. A subscription token is fine.
# "shared"   — anyone else can call it. Refuses a subscription token and
#              requires ANTHROPIC_API_KEY / Bedrock / Vertex.
# There is no default: the mode is always a deliberate choice.
RUNNER_MODE=personal

# Your Claude credential. Generate with:
#   claude setup-token
# Required in a container: there is no interactive login and no OS keychain
# inside one, so the CLI cannot find a login on its own.
CLAUDE_CODE_OAUTH_TOKEN=

# Shared secret callers must present, as a Bearer token or a "secret" body
# field. Store only the digest:
#   printf '%s' 'a-long-random-secret' | shasum -a 256
# Mandatory on any non-loopback bind — which includes every container.
RUNNER_SECRET_SHA256=

# A container has to accept traffic from outside its network namespace, so it
# binds 0.0.0.0 and the personal-mode guard requires you to acknowledge that.
# Publish the port to loopback (or a private overlay) rather than to the world:
#   docker run -p 127.0.0.1:8788:8788 ...
RUNNER_ALLOW_REMOTE=1

# ---------------------------------------------------------------- optional

# Model alias the CLI accepts directly: sonnet, opus, haiku, or a full id
# such as claude-sonnet-5.
CHAT_MODEL=sonnet
# JSON_MODEL=sonnet

# BIND=0.0.0.0
# PORT=8788
# STATE_FILE=/var/lib/claude-runner/state.json

# Browser origins allowed to call this. "*" is the default and is only
# reasonable behind a private network — set the real origin if a page calls it.
# ALLOWED_ORIGINS=https://notes.example.internal

# Quotas. CALLS_PER_* are keyed on a hash of caller IP + secret, so someone
# rotating addresses earns a fresh allowance from them. GLOBAL_CALLS_PER_HOUR
# and DAILY_TOKEN_BUDGET carry no caller in their keys and are the limits that
# actually bound a runaway client or a leaked secret.
#
# Size DAILY_TOKEN_BUDGET against your real cost per call, which is dominated
# by the system prompt, not the answer: a call carrying a 56k-token system
# prompt costs ~56k tokens whether the reply is 60 tokens or 600.
# CALLS_PER_HOUR=60
# CALLS_PER_DAY=300
# GLOBAL_CALLS_PER_HOUR=90
# DAILY_TOKEN_BUDGET=3000000

# Milliseconds. Keep these under any proxy or platform request timeout in front
# of the service, so this code's own timeout fires first with a clean error
# instead of the proxy hanging up mid-stream.
# CHAT_TIMEOUT_MS=90000
# JSON_TIMEOUT_MS=60000

# Extra variables to forward into the CLI child process, comma-separated. The
# child gets a deliberately minimal environment (see README, "Why the child
# environment is minimal"); name anything else the CLI needs here.
# CLAUDE_RUNNER_PASSTHROUGH=HTTPS_PROXY,NO_PROXY,NODE_EXTRA_CA_CERTS

# Absolute path to the CLI binary, if you are not using the npm dependency.
# CLAUDE_BIN=/usr/local/bin/claude
